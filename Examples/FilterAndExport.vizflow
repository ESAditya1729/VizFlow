{
  "name": "Filter and Export",
  "version": "1.0.0",
  "createdAt": "2026-08-20T00:00:00.000Z",
  "activities": [
    {
      "id": "step_1",
      "type": "readCsv",
      "displayName": "Read Data",
      "config": {
        "filePath": "./data.csv",
        "delimiter": ",",
        "hasHeader": true,
        "encoding": "utf8"
      }
    },
    {
      "id": "step_2",
      "type": "filter",
      "displayName": "Filter Rows",
      "config": {
        "column": "a1",
        "operator": "==",
        "value": "value"
      }
    },
    {
      "id": "step_3",
      "type": "writeCsv",
      "displayName": "Export Results",
      "config": {
        "filePath": "./filtered_output.csv",
        "delimiter": ",",
        "includeHeader": true
      }
    }
  ],
  "edges": [
    {
      "id": "edge_1",
      "source": { "nodeId": "step_1", "port": "output" },
      "target": { "nodeId": "step_2", "port": "input" }
    },
    {
      "id": "edge_2",
      "source": { "nodeId": "step_2", "port": "output" },
      "target": { "nodeId": "step_3", "port": "input" }
    }
  ]
}
