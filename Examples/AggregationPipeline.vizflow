{
  "name": "Aggregation Pipeline",
  "version": "1.0.0",
  "createdAt": "2026-08-20T00:00:00.000Z",
  "activities": [
    {
      "id": "step_1",
      "type": "readCsv",
      "displayName": "Read Sales Data",
      "config": {
        "filePath": "./sales.csv",
        "delimiter": ",",
        "hasHeader": true,
        "encoding": "utf8"
      }
    },
    {
      "id": "step_2",
      "type": "groupBy",
      "displayName": "Group by Category",
      "config": {
        "groupByColumn": "a2",
        "aggregations": [
          { "column": "a3", "operation": "sum", "alias": "total" },
          { "column": "a3", "operation": "count", "alias": "count" }
        ]
      }
    },
    {
      "id": "step_3",
      "type": "sort",
      "displayName": "Sort by Total",
      "config": {
        "column": "total",
        "direction": "desc"
      }
    },
    {
      "id": "step_4",
      "type": "writeCsv",
      "displayName": "Export Summary",
      "config": {
        "filePath": "./category_summary.csv",
        "delimiter": ",",
        "includeHeader": true
      }
    }
  ],
  "edges": [
    {
      "id": "edge_1",
      "source": { "nodeId": "step_1", "port": "output" },
      "target": { "nodeId": "step_2", "port": "input" }
    },
    {
      "id": "edge_2",
      "source": { "nodeId": "step_2", "port": "output" },
      "target": { "nodeId": "step_3", "port": "input" }
    },
    {
      "id": "edge_3",
      "source": { "nodeId": "step_3", "port": "output" },
      "target": { "nodeId": "step_4", "port": "input" }
    }
  ]
}
