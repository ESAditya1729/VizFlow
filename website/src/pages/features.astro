---
import Base from '../layouts/Base.astro';
import InstallBox from '../components/InstallBox.astro';
import ScreenshotPlaceholder from '../components/ScreenshotPlaceholder.astro';
import ScreenshotGallery from '../components/ScreenshotGallery.astro';
import { FEATURES } from '../data/features';
---

<Base
  title="Features"
  description="CSV Compare, RBQL Query Console, Dashboard, Visual Workflow Builder, Charts & Transformations, and Scheduler & Data Sources — all inside VS Code."
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h1>Features</h1>
        <p>Six tools for working with data, built into VS Code.</p>
      </div>

      {
        FEATURES.map((feature, i) => (
          <article
            class={`feature-row${i % 2 ? ' reverse' : ''}${feature.images?.length ? ' has-gallery' : ''}`}
            id={feature.id}
          >
            <div class="feature-copy">
              <span class="feature-glyph" aria-hidden="true">{feature.glyph}</span>
              <h2>{feature.title}</h2>
              <p class="tagline">{feature.tagline}</p>
              <p>{feature.summary}</p>
              <ul>
                {feature.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
            {feature.images?.length ? (
              <ScreenshotGallery images={feature.images} label={feature.title} />
            ) : (
              <ScreenshotPlaceholder label={feature.shot} glyph={feature.glyph} />
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section class="cta">
    <div class="container">
      <h2>Install VizFlow Studio</h2>
      <p class="muted">Free on the Visual Studio Marketplace.</p>
      <InstallBox id="features-install" />
    </div>
  </section>
</Base>
