---
import { SITE } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <span>© {year} {SITE.name}. Runs locally — your data stays on your machine.</span>
    <nav class="footer-links" aria-label="Footer">
      <a href={SITE.marketplaceUrl} rel="noopener">Marketplace</a>
      <a href={SITE.repoUrl} rel="noopener">GitHub</a>
      <a href={SITE.issuesUrl} rel="noopener">Issues</a>
      <a href={SITE.discussionsUrl} rel="noopener">Discussions</a>
    </nav>
  </div>
</footer>
