{
  "name": "vizflow-studio",
  "displayName": "VizFlow Studio",
  "description": "Analyze, transform, and visualize CSV data directly inside Visual Studio Code.",
  "version": "0.0.1",
  "publisher": "adoenixes-vizflow",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Data Science",
    "Visualization"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ESAditya1729/VizFlow"
  },
  "keywords": [
    "data-analysis",
    "csv",
    "visualization",
    "RBQL",
    "data-science",
    "data-transformation",
    "data-visualization",
    "data-insights",
    "data-exploration"
  ],
  "activationEvents": [
    "onLanguage:csv",
    "onLanguage:tsv",
    "onCommand:vizflow.sum",
    "onCommand:vizflow.average",
    "onCommand:vizflow.min",
    "onCommand:vizflow.max",
    "onCommand:vizflow.count",
    "onCommand:vizflow.duplicates",
    "onCommand:vizflow.statistics",
    "onCommand:vizflow.distinctValues",
    "onCommand:vizflow.transform",
    "onCommand:vizflow.transformWebview",
    "onCommand:vizflow.compareCSV",
    "onCommand:vizflow.about",
    "onCommand:vizflow.dashboard",
    "onCommand:vizflow.charts",
    "onCommand:vizflow.rbqlQuery",
    "onCommand:vizflow.workflowBuilder",
    "onCommand:vizflow.openWorkflow",
    "onCommand:vizflow.scheduler",
    "onCommand:vizflow.scheduler.quickSchedule",
    "onCommand:vizflow.scheduler.stopJob",
    "onCommand:vizflow.scheduler.showRunning"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vizflow.sum",
        "title": "VizFlow: Sum Column"
      },
      {
        "command": "vizflow.average",
        "title": "VizFlow: Average Column"
      },
      {
        "command": "vizflow.min",
        "title": "VizFlow: Minimum Value"
      },
      {
        "command": "vizflow.max",
        "title": "VizFlow: Maximum Value"
      },
      {
        "command": "vizflow.count",
        "title": "VizFlow: Count Values"
      },
      {
        "command": "vizflow.duplicates",
        "title": "VizFlow: Find Duplicate Values"
      },
      {
        "command": "vizflow.statistics",
        "title": "VizFlow: Show Column Statistics"
      },
      {
        "command": "vizflow.distinctValues",
        "title": "VizFlow: Show Distinct Values"
      },
      {
        "command": "vizflow.transform",
        "title": "VizFlow: Transform Column"
      },
      {
        "command": "vizflow.transformWebview",
        "title": "VizFlow: Transform Column (Visual)"
      },
      {
        "command": "vizflow.compareCSV",
        "title": "VizFlow: Compare CSV Files"
      },
      {
        "command": "vizflow.about",
        "title": "VizFlow: About / Creator"
      },
      {
        "command": "vizflow.dashboard",
        "title": "VizFlow: Dataset Summary Dashboard"
      },
      {
        "command": "vizflow.charts",
        "title": "VizFlow: Interactive Charts"
      },
      {
        "command": "vizflow.rbqlQuery",
        "title": "VizFlow: RBQL Query Console"
      },
      {
        "command": "vizflow.workflowBuilder",
        "title": "VizFlow: Workflow Builder"
      },
      {
        "command": "vizflow.openWorkflow",
        "title": "VizFlow: Open in Workflow Builder"
      },
      {
        "command": "vizflow.scheduler",
        "title": "VizFlow: Workflow Scheduler"
      },
      {
        "command": "vizflow.scheduler.quickSchedule",
        "title": "VizFlow: Quick Schedule Workflow"
      },
      {
        "command": "vizflow.scheduler.stopJob",
        "title": "VizFlow: Stop Running Job"
      },
      {
        "command": "vizflow.scheduler.showRunning",
        "title": "VizFlow: Show Running Jobs"
      }
    ],
    "languages": [
      {
        "id": "vizflow",
        "aliases": [
          "VizFlow Workflow",
          "vizflow"
        ],
        "extensions": [
          ".vizflow"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "vizflow.openWorkflow",
          "when": "resourceExtname == .vizflow",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "vizflow.openWorkflow",
          "when": "resourceExtname == .vizflow",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "gen:context": "node scripts/generate-ai-context.js",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "globals": "^17.8.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "node-cron": "^4.6.0",
    "papaparse": "^5.5.4",
    "rbql": "^0.30.0",
    "xlsx": "^0.18.5"
  }
}
